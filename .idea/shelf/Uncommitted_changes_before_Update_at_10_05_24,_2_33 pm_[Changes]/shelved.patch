+
+public class MaxConsecutiveOnes {
+    public static void main(String[] args) {
+        int[] nums={1,1,0,1,1,1};
+        ArrayList<Integer> list=new ArrayList<>();
+        int one=0;
+        for (int i = 0; i < nums.length; i++) {
